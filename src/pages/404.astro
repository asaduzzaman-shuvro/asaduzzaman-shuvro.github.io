---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<!-- GitHub Pages serves dist/404.html for any unknown path. The sitemap integration skips it. -->
<Base title={`Page not found — ${profile.name}`} description="This page doesn't exist." noindex>
  <Header />
  <main class="mx-auto max-w-3xl px-5 pt-40 pb-32">
    <p class="mono-label mb-4">// 404</p>
    <h1 class="display text-5xl text-fg sm:text-7xl">Nothing here<span class="text-lime">.</span></h1>
    <p class="mt-6 text-lg text-muted">The page you were looking for moved or never existed.</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 border border-lime bg-lime px-6 py-3 font-mono text-sm font-semibold tracking-wide text-black uppercase"
      >
        <span aria-hidden="true">▸</span> Home
      </a>
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 border border-line-strong px-6 py-3 font-mono text-sm font-semibold tracking-wide text-fg uppercase transition-colors hover:border-lime hover:text-lime"
      >
        <span aria-hidden="true">▸</span> Writing
      </a>
    </div>
  </main>
  <Footer />
</Base>
