---
// Social-share card, 1200×630. Not a page for people: `npm run og` screenshots it to
// public/og.png with headless Chrome. Skips Base.astro (no header/meta/scripts), is noindex,
// and is filtered out of the sitemap in astro.config.mjs.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile } from '../data/profile';

const host = Astro.site!.host;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — share card</title>
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="bg-base text-fg">
    <main class="relative flex h-[630px] w-[1200px] flex-col justify-between overflow-hidden p-[72px]">
      <div class="grid-lines pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute -top-48 -left-48 h-[38rem] w-[38rem] rounded-full bg-lime/10 blur-[120px]"
        aria-hidden="true"
      >
      </div>

      <p class="relative flex items-center gap-3 font-mono text-xl tracking-[0.18em] text-muted uppercase">
        <span class="inline-block h-4 w-4 bg-lime"></span>
        {profile.role} · {profile.tagline}
      </p>

      <div class="relative">
        <h1 class="display text-[112px] text-fg">
          {profile.name}<span class="text-lime">.</span>
        </h1>
        <p class="mt-8 max-w-[900px] text-[32px] leading-snug text-muted">{profile.pitch}</p>
      </div>

      <p class="relative flex items-center justify-between font-mono text-xl tracking-wider text-faint">
        <span>{host}</span>
        <span class="h-4 w-4 bg-lime" aria-hidden="true"></span>
      </p>
    </main>
  </body>
</html>
