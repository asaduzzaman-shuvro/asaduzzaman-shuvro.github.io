---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { profile } from '../../data/profile';
import { jsonLd, projectSchema } from '../../data/schema';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const url = new URL(Astro.url.pathname, Astro.site);

const linkLabels: Record<string, string> = {
  github: 'View on GitHub',
  appstore: 'App Store',
  live: 'Live site',
};
const links = Object.entries(data.links).filter(([, url]) => Boolean(url)) as [string, string][];
---

<Base title={`${data.title} — ${profile.name}`} description={data.summary}>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLd(projectSchema(data, url, Astro.site!))} />
  <Header />
  <main class="mx-auto max-w-3xl px-5 pt-28 pb-20">
    <a href="/#work" class="text-sm font-medium text-accent-600 hover:underline dark:text-accent-400">← Back to work</a>

    <header class="mt-6">
      <span class="rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700 dark:bg-accent-500/10 dark:text-accent-400">
        {data.type === 'professional' ? 'Professional' : 'Open source'}
      </span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">{data.title}</h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">{data.summary}</p>
    </header>

    <dl class="mt-8 grid grid-cols-2 gap-4 rounded-xl border border-slate-200 p-5 text-sm sm:grid-cols-3 dark:border-slate-800">
      <div>
        <dt class="font-semibold text-slate-900 dark:text-white">Role</dt>
        <dd class="mt-1 text-slate-600 dark:text-slate-300">{data.role}</dd>
      </div>
      {data.teamSize && (
        <div>
          <dt class="font-semibold text-slate-900 dark:text-white">Team</dt>
          <dd class="mt-1 text-slate-600 dark:text-slate-300">{data.teamSize}</dd>
        </div>
      )}
      <div class="col-span-2 sm:col-span-1">
        <dt class="font-semibold text-slate-900 dark:text-white">Tech</dt>
        <dd class="mt-1 text-slate-600 dark:text-slate-300">{data.tech.join(', ')}</dd>
      </div>
    </dl>

    {data.outcomes.length > 0 && (
      <ul class="mt-6 space-y-2">
        {data.outcomes.map((o) => (
          <li class="flex gap-3 text-slate-700 dark:text-slate-200">
            <span class="mt-1 text-accent-500" aria-hidden="true">▸</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    )}

    {links.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3">
        {links.map(([key, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
          >
            {linkLabels[key] ?? key} →
          </a>
        ))}
      </div>
    )}

    <article class="prose prose-slate mt-12 max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-accent-600 dark:prose-a:text-accent-400">
      <Content />
    </article>
  </main>
  <Footer />
</Base>
