---
// Printable résumé, generated from the same data as the site. `npm run cv` prints it to
// public/cv.pdf. Light-on-white on purpose: it is made for paper and ATS parsers, not the
// dark brand canvas, so it skips Base.astro and global.css.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { getCollection } from 'astro:content';
import { profile, statements, experience, education, languages } from '../data/profile';

const projects = (await getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) =>
    a.data.type === b.data.type ? a.data.order - b.data.order : a.data.type === 'professional' ? -1 : 1
  );

const site = Astro.site!;
const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: strip(profile.linkedin), href: profile.linkedin },
  { label: strip(profile.github), href: profile.github },
  { label: strip(site.href), href: site.href },
];
const projectLink = (links: { github?: string; appstore?: string; live?: string }) =>
  links.appstore ?? links.live ?? links.github;
const title = `${profile.name} — CV`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={profile.summary} />
    <link rel="canonical" href={new URL('/cv/', site)} />
  </head>
  <body>
    <nav class="toolbar" aria-label="CV actions">
      <a href="/">← Back to site</a>
      <a href={profile.cv} download>Download PDF</a>
    </nav>

    <main class="page">
      <header class="head">
        <h1>{profile.name}<span class="dot" aria-hidden="true"></span></h1>
        <p class="role">{profile.role} · {profile.tagline}</p>
        <ul class="contacts">
          <li>{profile.location}</li>
          {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{profile.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          experience.map((job) => (
            <article class="job">
              <div class="job-head">
                <h3>
                  {job.role}
                  <span class="company">{job.company}</span>
                </h3>
                <p class="period">{job.period}</p>
              </div>
              <ul class="bullets">
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {job.apps.length > 0 && <p class="apps">Apps: {job.apps.join(', ')}</p>}
            </article>
          ))
        }
      </section>

      <section>
        <h2>Selected work</h2>
        <ul class="projects">
          {
            projects.map((p) => {
              const href = projectLink(p.data.links);
              return (
                <li>
                  <p class="project-head">
                    <strong>{p.data.title}</strong>
                    {href && <a href={href}>{strip(href)}</a>}
                  </p>
                  <p class="project-summary">{p.data.summary}</p>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {
            statements.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd>{s.skills.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="split">
        <div>
          <h2>Education</h2>
          <p><strong>{education.degree}</strong> · {education.year}</p>
          <p>{education.school}</p>
        </div>
        <div>
          <h2>Languages</h2>
          {languages.map((l) => <p><strong>{l.name}</strong> — {l.level}</p>)}
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --ink: #111113;
    --muted: #4b4b55;
    --rule: #d9d9de;
    --accent: #c6ff00;
    --paper-bg: #e9e9ec;
    color-scheme: light;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
  }
  body {
    background: var(--paper-bg);
    color: var(--ink);
    font-family: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 10pt;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }
  a:hover {
    text-decoration-color: var(--ink);
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    max-width: 210mm;
    margin: 0 auto;
    padding: 16px;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 12px;
    text-transform: uppercase;
  }
  .toolbar a {
    text-decoration: none;
  }

  .page {
    max-width: 210mm;
    margin: 0 auto 48px;
    padding: 16mm 16mm 18mm;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  .head {
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }
  h1 {
    margin: 0;
    font-family: 'Space Grotesk Variable', 'Space Grotesk', ui-sans-serif, sans-serif;
    font-size: 26pt;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .dot {
    display: inline-block;
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.08em;
    background: var(--accent);
    outline: 1px solid var(--ink);
  }
  .role {
    margin: 6px 0 0;
    font-size: 12pt;
    font-weight: 600;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 9pt;
  }

  section {
    margin-top: 14px;
  }
  h2 {
    margin: 0 0 6px;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
  }
  p {
    margin: 0;
  }

  .job {
    padding: 8px 0;
    border-top: 1px solid var(--rule);
    break-inside: avoid;
  }
  .job:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h3 {
    margin: 0;
    font-size: 10.5pt;
    font-weight: 700;
  }
  .company {
    font-weight: 400;
    color: var(--muted);
  }
  .company::before {
    content: ' · ';
  }
  .period {
    flex-shrink: 0;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 8.5pt;
    color: var(--muted);
  }
  .bullets {
    margin: 4px 0 0;
    padding-left: 16px;
  }
  .bullets li + li {
    margin-top: 2px;
  }
  .apps {
    margin-top: 4px;
    font-size: 8.5pt;
    color: var(--muted);
  }

  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects li + li {
    margin-top: 6px;
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .project-head a {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 8.5pt;
  }
  .project-summary {
    color: var(--muted);
  }

  .skills {
    margin: 0;
  }
  .skills div {
    display: grid;
    grid-template-columns: 26mm 1fr;
    gap: 8px;
  }
  .skills div + div {
    margin-top: 3px;
  }
  .skills dt {
    font-weight: 700;
  }
  .skills dd {
    margin: 0;
  }

  .split {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
    break-inside: avoid;
  }

  /* Phones: let the sheet go edge to edge. */
  @media (max-width: 640px) {
    .page {
      padding: 20px 16px;
      box-shadow: none;
    }
    .job-head,
    .split {
      display: block;
    }
    .split > div + div {
      margin-top: 14px;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* Comfortable tap targets on screen; print keeps the tight layout. */
  @media screen {
    .contacts {
      row-gap: 4px;
    }
    .contacts a,
    .toolbar a,
    .project-head a {
      display: inline-block;
      padding: 4px 0;
    }
  }

  @page {
    size: A4;
    margin: 14mm 16mm;
  }
  @media print {
    body {
      background: #fff;
    }
    .toolbar {
      display: none;
    }
    .page {
      max-width: none;
      margin: 0;
      box-shadow: none;
      padding: 0;
    }
    a {
      text-decoration: none;
    }
  }
</style>
