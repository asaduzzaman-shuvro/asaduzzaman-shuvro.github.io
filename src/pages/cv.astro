---
// Printable résumé, generated from the same data as the site. `npm run cv` prints it to
// public/cv.pdf. Shares the paper styles with /letter (src/styles/paper.css).
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/paper.css';
import { getCollection } from 'astro:content';
import { profile, statements, experience, education, languages, interests } from '../data/profile';
import { sortProjects } from '../data/projects';

const projects = sortProjects(await getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true));

const site = Astro.site!;
const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: strip(profile.linkedin), href: profile.linkedin },
  { label: strip(profile.github), href: profile.github },
  { label: strip(site.href), href: site.href },
];
const projectLink = (links: { github?: string; appstore?: string; live?: string }) =>
  links.appstore ?? links.live ?? links.github;
const title = `${profile.name} — CV`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={profile.summary} />
    <link rel="canonical" href={new URL('/cv/', site)} />
  </head>
  <body>
    <nav class="toolbar" aria-label="CV actions">
      <a href="/">← Back to site</a>
      <a href={profile.cv} download>Download PDF</a>
    </nav>

    <main class="page">
      <header class="head">
        <h1>{profile.name}<span class="dot" aria-hidden="true"></span></h1>
        <p class="role">{profile.role} · {profile.tagline}</p>
        <ul class="contacts">
          <li>{profile.location}</li>
          {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{profile.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          experience.map((job) => (
            <article class="job">
              <div class="job-head">
                <h3>
                  {job.role}
                  <span class="company">{job.company}</span>
                </h3>
                <p class="period">{job.period}</p>
              </div>
              <ul class="bullets">
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {job.apps.length > 0 && <p class="apps">Apps: {job.apps.join(', ')}</p>}
            </article>
          ))
        }
      </section>

      <section>
        <h2>Selected work</h2>
        <ul class="projects">
          {
            projects.map((p) => {
              const href = projectLink(p.data.links);
              return (
                <li>
                  <p class="project-head">
                    <strong>{p.data.title}</strong>
                    {href && <a href={href}>{strip(href)}</a>}
                  </p>
                  <p class="project-summary">{p.data.summary}</p>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {
            statements.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd>{s.skills.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="split">
        <div>
          <h2>Education</h2>
          <p><strong>{education.degree}</strong> · {education.year}</p>
          <p>{education.school}</p>
        </div>
        <div>
          <h2>Languages</h2>
          {languages.map((l) => <p><strong>{l.name}</strong> — {l.level}</p>)}
        </div>
        <div>
          <h2>Interests</h2>
          <p>{interests.join(' · ')}</p>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  .job {
    padding: 8px 0;
    border-top: 1px solid var(--rule);
    break-inside: avoid;
  }
  .job:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h3 {
    margin: 0;
    font-size: 10.5pt;
    font-weight: 700;
  }
  .company {
    font-weight: 400;
    color: var(--muted);
  }
  .company::before {
    content: ' · ';
  }
  .period {
    flex-shrink: 0;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 8.5pt;
    color: var(--muted);
  }
  .bullets {
    margin: 4px 0 0;
    padding-left: 16px;
  }
  .bullets li + li {
    margin-top: 2px;
  }
  .apps {
    margin-top: 4px;
    font-size: 8.5pt;
    color: var(--muted);
  }

  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects li + li {
    margin-top: 6px;
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .project-head a {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 8.5pt;
  }
  .project-summary {
    color: var(--muted);
  }

  .skills {
    margin: 0;
  }
  .skills div {
    display: grid;
    grid-template-columns: 26mm 1fr;
    gap: 8px;
  }
  .skills div + div {
    margin-top: 3px;
  }
  .skills dt {
    font-weight: 700;
  }
  .skills dd {
    margin: 0;
  }

  .split {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 24px;
    break-inside: avoid;
  }

  @media (max-width: 640px) {
    .job-head,
    .split {
      display: block;
    }
    .split > div + div {
      margin-top: 14px;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media screen {
    .project-head a {
      display: inline-block;
      padding: 4px 0;
    }
  }
</style>
