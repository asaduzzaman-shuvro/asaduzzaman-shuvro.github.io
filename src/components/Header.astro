---
import { profile } from '../data/profile';

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'Stack', href: '/#stack' },
  { label: 'Notes', href: '/#notes' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-base/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href="/" class="font-mono text-sm font-bold tracking-tight text-fg">
      {profile.handle}<span class="text-lime">.</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 sm:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="px-3 py-2 font-mono text-xs tracking-wider text-muted uppercase transition-colors hover:text-lime"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile menu toggle -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-9 items-center gap-2 border border-line-strong px-3 font-mono text-xs tracking-wider text-fg uppercase transition-colors hover:border-lime hover:text-lime sm:hidden"
    >
      <span id="menu-label">Menu</span>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" hidden class="border-t border-line bg-base/95 backdrop-blur-md sm:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-5 py-2">
      {
        links.map((l) => (
          <li class="border-b border-line/60 last:border-0">
            <a
              href={l.href}
              class="block py-3 font-mono text-sm tracking-wider text-fg uppercase transition-colors hover:text-lime"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const label = document.getElementById('menu-label');
    if (!toggle || !menu) return;

    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
  })();
</script>
