---
import { profile } from '../data/profile';

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'Leading', href: '/#leading' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Writing', href: '/#notes' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-base/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5">
    <a href="/" class="font-display text-lg font-semibold tracking-tight text-fg">
      {profile.name}
    </a>

    <div class="flex items-center gap-1">
      <!-- Desktop nav -->
      <ul class="hidden items-center md:flex">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="px-3 py-2 text-sm text-muted transition-colors hover:text-accent-600">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Theme toggle: shows the theme you'd switch to. -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-panel hover:text-fg"
      >
        <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-9 items-center rounded-full border border-line-strong px-4 text-sm text-fg transition-colors hover:border-accent-600 hover:text-accent-600 md:hidden"
      >
        <span id="menu-label">Menu</span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" hidden class="border-t border-line bg-base/95 backdrop-blur-md md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-5 py-2">
      {
        links.map((l) => (
          <li class="border-b border-line last:border-0">
            <a href={l.href} class="block py-3 font-display text-xl text-fg transition-colors hover:text-accent-600">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const theme = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const label = () =>
      theme?.setAttribute('aria-label', root.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme');
    label();
    theme?.addEventListener('click', () => {
      window.setTheme?.(!root.classList.contains('dark'));
      label();
    });

    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const menuLabel = document.getElementById('menu-label');
    if (!toggle || !menu) return;

    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (menuLabel) menuLabel.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
  })();
</script>
