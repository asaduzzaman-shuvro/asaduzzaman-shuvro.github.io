---
import { profile, socials } from '../data/profile';
---

<section id="contact" class="scroll-mt-16 border-t border-slate-100 py-20 dark:border-slate-900">
  <div class="mx-auto max-w-3xl px-5 text-center">
    <h2 class="reveal text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Let's build something
    </h2>
    <p class="reveal mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-300">
      Open to engineering leadership roles, freelance projects, and a good conversation about
      mobile or backend. The fastest way to reach me is email.
    </p>

    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center rounded-lg bg-accent-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent-600/25 transition-transform hover:-translate-y-0.5 hover:bg-accent-700"
      >
        {profile.email}
      </a>
      {
        socials
          .filter((s) => s.label !== 'Email')
          .map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
            >
              {s.label}
            </a>
          ))
      }
    </div>
  </div>
</section>
