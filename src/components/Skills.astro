---
import { skillGroups } from '../data/profile';
---

<section id="skills" class="scroll-mt-16 bg-slate-50 py-20 dark:bg-slate-900/40">
  <div class="mx-auto max-w-5xl px-5">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        What I work with
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        Not a logo wall — the tools I actually build and lead with, grouped by where they fit.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        skillGroups.map((group) => (
          <div class="reveal rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">{group.title}</h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{group.blurb}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((s) => (
                <li class="rounded-md bg-slate-100 px-2.5 py-1 font-mono text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  {s}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
