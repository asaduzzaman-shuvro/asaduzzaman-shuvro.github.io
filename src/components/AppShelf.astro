---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { shippedApps } from '../data/profile';

// Icons at src/assets/apps/<slug>.png (the App Store artwork). A missing icon falls back to a
// monogram tile, so the shelf never waits on assets.
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*.png', { eager: true });
const iconFor = (slug: string) => icons[`../assets/apps/${slug}.png`]?.default;
const monogram = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
---

<section aria-labelledby="apps-title" class="border-y border-line bg-panel">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 id="apps-title" class="kicker">On the App Store</h2>
      <p class="text-sm text-muted">DN Media Group’s news apps, built and run by the iOS team I lead.</p>
    </div>

    <ul class="mt-8 grid grid-cols-4 gap-x-4 gap-y-8 sm:grid-cols-8">
      {
        shippedApps.map((app) => {
          const icon = iconFor(app.slug);
          return (
            <li>
              <a
                href={app.appStore}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center text-center"
                title={app.blurb}
              >
                {icon ? (
                  <Image
                    src={icon}
                    alt=""
                    width={144}
                    height={144}
                    class="aspect-square w-full max-w-[4.5rem] rounded-[22.5%] shadow-[0_1px_2px_rgb(0_0_0/0.08),0_8px_24px_-8px_rgb(0_0_0/0.25)] ring-1 ring-black/5 transition-transform duration-300 group-hover:-translate-y-1"
                  />
                ) : (
                  <span
                    class="display flex aspect-square w-full max-w-[4.5rem] items-center justify-center rounded-[22.5%] border border-line-strong text-xl text-accent-600"
                    aria-hidden="true"
                  >
                    {monogram(app.name)}
                  </span>
                )}
                <span class="mt-3 text-xs font-medium text-fg transition-colors group-hover:text-accent-600 sm:text-sm">
                  {app.name}
                </span>
                <span class="sr-only">: {app.blurb}, on the App Store (opens in a new tab)</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
