---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import portrait from '../assets/portrait.jpg';
---

<section id="about" class="scroll-mt-14 border-b border-line py-24">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[1fr_1.5fr] md:items-start">
    <div class="reveal">
      <p class="mono-label mb-4">// about</p>
      <div class="relative aspect-square w-full max-w-sm border border-line bg-panel">
        <Image
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          widths={[384, 768]}
          sizes="(min-width: 768px) 384px, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        <span class="absolute bottom-0 left-0 h-3 w-3 bg-lime" aria-hidden="true"></span>
      </div>
    </div>

    <div class="reveal">
      <h2 class="display text-4xl text-fg sm:text-5xl">
        {profile.name}
      </h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>

      <dl class="mt-8 grid grid-cols-2 gap-px border border-line bg-line">
        <div class="bg-base px-4 py-3">
          <dt class="mono-label mb-1">role</dt>
          <dd class="font-mono text-sm text-fg">{profile.role}</dd>
        </div>
        <div class="bg-base px-4 py-3">
          <dt class="mono-label mb-1">consulting for</dt>
          <dd class="font-mono text-sm text-fg">{profile.client}</dd>
        </div>
        <div class="bg-base px-4 py-3">
          <dt class="mono-label mb-1">based</dt>
          <dd class="font-mono text-sm text-fg">Dhaka → relocating to Norway</dd>
        </div>
        <div class="bg-base px-4 py-3">
          <dt class="mono-label mb-1">education</dt>
          <dd class="font-mono text-sm text-fg">B.Sc. CSE · DUET</dd>
        </div>
      </dl>

      <a
        href={profile.cv}
        download
        class="mt-8 inline-flex items-center gap-2 border border-line-strong px-5 py-3 font-mono text-xs tracking-wider text-fg uppercase transition-colors hover:border-lime hover:text-lime"
      >
        <span aria-hidden="true">▸</span> Download CV
      </a>
    </div>
  </div>
</section>
