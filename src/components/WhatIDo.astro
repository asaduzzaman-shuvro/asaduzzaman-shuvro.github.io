---
import { statements } from '../data/profile';
---

<section id="stack" class="scroll-mt-14 border-b border-line py-24">
  <div class="mx-auto max-w-6xl px-5">
    <p class="reveal mono-label mb-4">// what I do</p>

    <div class="grid gap-px border border-line bg-line md:grid-cols-2">
      {
        statements.map((s, i) => (
          <div class="reveal flex flex-col bg-base p-7">
            <span class="display text-3xl text-line-strong" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display mt-4 text-2xl text-lime">{s.headline}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.blurb}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.skills.map((skill) => (
                <li class="border border-line px-2 py-1 font-mono text-xs text-faint">{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
