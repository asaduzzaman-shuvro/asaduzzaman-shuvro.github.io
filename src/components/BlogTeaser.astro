---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

{
  posts.length > 0 && (
    <section id="writing" class="scroll-mt-16 bg-slate-50 py-20 dark:bg-slate-900/40">
      <div class="mx-auto max-w-5xl px-5">
        <div class="reveal flex items-end justify-between">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
              Writing
            </h2>
            <p class="mt-3 text-slate-600 dark:text-slate-300">Notes on what I'm building and learning.</p>
          </div>
          <a
            href="/blog"
            class="hidden shrink-0 text-sm font-semibold text-accent-600 hover:underline sm:block dark:text-accent-400"
          >
            All posts →
          </a>
        </div>

        <ul class="mt-10 divide-y divide-slate-200 dark:divide-slate-800">
          {posts.map((post) => (
            <li class="reveal">
              <a href={`/blog/${post.id}`} class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6">
                <time datetime={post.data.pubDate.toISOString()} class="shrink-0 font-mono text-xs text-slate-400 sm:w-28">
                  {fmt(post.data.pubDate)}
                </time>
                <div>
                  <h3 class="font-semibold text-slate-900 transition-colors group-hover:text-accent-600 dark:text-white dark:group-hover:text-accent-400">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <a href="/blog" class="reveal mt-6 inline-block text-sm font-semibold text-accent-600 hover:underline sm:hidden dark:text-accent-400">
          All posts →
        </a>
      </div>
    </section>
  )
}
