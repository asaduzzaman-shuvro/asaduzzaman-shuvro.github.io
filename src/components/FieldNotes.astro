---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

{
  posts.length > 0 && (
    <section id="notes" class="scroll-mt-14 border-b border-line py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal flex items-end justify-between">
          <div>
            <p class="mono-label mb-4">// field notes</p>
            <h2 class="display text-4xl text-fg sm:text-6xl">Writing</h2>
          </div>
          <a
            href="/blog/"
            class="hidden shrink-0 font-mono text-xs tracking-wider text-faint uppercase transition-colors hover:text-lime sm:block"
          >
            All posts →
          </a>
        </div>

        <ul class="mt-12 border-t border-line">
          {posts.map((post) => (
            <li class="reveal border-b border-line">
              <a
                href={`/blog/${post.id}/`}
                class="group grid gap-2 py-6 transition-colors sm:grid-cols-[8rem_1fr] sm:gap-8"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-xs tracking-wider text-faint uppercase"
                >
                  {fmt(post.data.pubDate)}
                </time>
                <div>
                  <h3 class="display text-xl text-fg transition-colors group-hover:text-lime sm:text-2xl">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 text-sm text-muted">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {post.data.tags.map((t) => (
                        <li class="font-mono text-xs text-faint">#{t}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>

        <a
          href="/blog/"
          class="reveal mt-6 inline-block font-mono text-xs tracking-wider text-faint uppercase transition-colors hover:text-lime sm:hidden"
        >
          All posts →
        </a>
      </div>
    </section>
  )
}
