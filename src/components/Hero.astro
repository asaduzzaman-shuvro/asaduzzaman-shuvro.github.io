---
import { profile } from '../data/profile';
import { splitFixedCase } from '../data/case';
import HeroHeadline from './HeroHeadline.tsx';
---

<section id="top" class="relative overflow-hidden border-b border-line">
  <!-- blueprint grid backdrop -->
  <div class="grid-lines pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <!-- soft lime glow -->
  <div
    class="pointer-events-none absolute -top-40 -left-40 h-[34rem] w-[34rem] rounded-full bg-lime/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pt-32 pb-20 sm:pt-40 sm:pb-28">
    <p class="mono-label mb-6 flex items-center gap-2">
      <span class="inline-block h-2 w-2 bg-lime"></span>
      {profile.role} · {splitFixedCase(profile.tagline).map((part, k) => (k % 2 ? <span class="normal-case">{part}</span> : part))}
    </p>

    <HeroHeadline client:load />

    <p class="mt-8 max-w-2xl text-lg text-muted sm:text-xl">{profile.pitch}</p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#work"
        class="group inline-flex items-center gap-2 border border-lime bg-lime px-6 py-3 font-mono text-sm font-semibold tracking-wide text-black uppercase transition-transform hover:-translate-y-0.5"
      >
        <span aria-hidden="true">▸</span> See the work
      </a>
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 border border-line-strong px-6 py-3 font-mono text-sm font-semibold tracking-wide text-fg uppercase transition-colors hover:border-lime hover:text-lime"
      >
        <span aria-hidden="true">▸</span> Get in touch
      </a>
    </div>
  </div>
</section>
