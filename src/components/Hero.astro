---
import { profile, hero } from '../data/profile';
---

<section id="top" class="relative">
  <div class="mx-auto max-w-6xl px-5 pt-32 pb-16 sm:pt-40 sm:pb-20">
    <p class="kicker mb-8">{hero.kicker}</p>

    <h1 class="display max-w-5xl text-[clamp(2.75rem,8.2vw,6.75rem)] text-fg">
      {hero.headline.before}<em>{hero.headline.em}</em>{hero.headline.after}
    </h1>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{hero.lead}</p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href="#work"
        class="inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3 text-sm font-semibold text-base transition-transform hover:-translate-y-0.5"
      >
        See the work <span aria-hidden="true">→</span>
      </a>
      <a
        href={profile.cv}
        download
        class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-fg transition-colors hover:border-accent-600 hover:text-accent-600"
      >
        Download CV <span aria-hidden="true">↓</span>
      </a>
    </div>

    <p class="mt-8 flex max-w-2xl items-start gap-3 text-sm leading-relaxed text-muted">
      <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent-600" aria-hidden="true"></span>
      <span>{profile.availability}</span>
    </p>
  </div>
</section>
