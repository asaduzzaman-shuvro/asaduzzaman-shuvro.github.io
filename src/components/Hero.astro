---
import { profile } from '../data/profile';
---

<section class="relative overflow-hidden">
  <!-- Decorative gradient backdrop -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full bg-gradient-to-br from-accent-500/20 via-cyan-400/10 to-transparent blur-3xl"></div>
  </div>

  <div class="mx-auto flex min-h-[100svh] max-w-5xl flex-col justify-center px-5 pt-24 pb-16">
    <p class="reveal font-mono text-sm font-medium text-accent-600 dark:text-accent-400">
      Hi, I'm {profile.name.split(' ')[0]} 👋
    </p>

    <h1 class="reveal mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-white">
      {profile.role}
      <span class="block bg-gradient-to-r from-accent-500 to-cyan-400 bg-clip-text text-transparent">
        {profile.tagline}
      </span>
    </h1>

    <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      {profile.pitch}
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center gap-3">
      <a
        href="#work"
        class="inline-flex items-center rounded-lg bg-accent-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent-600/25 transition-transform hover:-translate-y-0.5 hover:bg-accent-700"
      >
        View my work
      </a>
      <a
        href={profile.cv}
        class="inline-flex items-center rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
        download
      >
        Download CV
      </a>
      <a
        href="#contact"
        class="inline-flex items-center px-3 py-3 text-sm font-semibold text-slate-600 underline-offset-4 hover:underline dark:text-slate-300"
      >
        Get in touch →
      </a>
    </div>
  </div>
</section>
