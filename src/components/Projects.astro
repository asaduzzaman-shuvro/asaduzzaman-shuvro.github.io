---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const all = await getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true);

// Professional first, then by `order`.
const typeRank = { professional: 0, 'open-source': 1 } as const;
const projects = all.sort((a, b) => {
  const t = typeRank[a.data.type] - typeRank[b.data.type];
  return t !== 0 ? t : a.data.order - b.data.order;
});
---

<section id="work" class="scroll-mt-14 border-b border-line py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mono-label mb-4">// selected work</p>
        <h2 class="display text-4xl text-fg sm:text-6xl">Things I've shipped</h2>
      </div>
      <p class="max-w-xs text-sm text-muted">
        Products I've led and built — case studies alongside open source.
      </p>
    </div>

    <div class="mt-14 grid gap-px border border-line bg-line sm:grid-cols-2">
      {
        projects.map((p, i) => (
          <ProjectCard
            index={i + 1}
            title={p.data.title}
            summary={p.data.summary}
            type={p.data.type}
            tech={p.data.tech}
            href={`/projects/${p.id}`}
          />
        ))
      }
    </div>
  </div>
</section>
