---
import { getCollection } from 'astro:content';
import AppShelf from './AppShelf.astro';
import ProjectCard from './ProjectCard.astro';
import { sortProjects } from '../data/projects';

const projects = sortProjects(await getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true));
---

<section id="work" class="scroll-mt-14 border-b border-line py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mono-label mb-4">// selected work</p>
        <h2 class="display text-4xl text-fg sm:text-6xl">Things I've shipped</h2>
      </div>
      <p class="max-w-xs text-sm text-muted">
        Products I've led and built — case studies alongside open source.
      </p>
    </div>

    <AppShelf />

    <p class="reveal mono-label mt-16">// case studies</p>
    <div class="mt-6 grid gap-px border border-line bg-line sm:grid-cols-2">
      {
        projects.map((p, i) => (
          <ProjectCard
            index={i + 1}
            title={p.data.title}
            summary={p.data.summary}
            type={p.data.type}
            tech={p.data.tech}
            href={`/projects/${p.id}/`}
            cover={p.data.cover}
            featured={i === 0}
          />
        ))
      }
    </div>
  </div>
</section>
