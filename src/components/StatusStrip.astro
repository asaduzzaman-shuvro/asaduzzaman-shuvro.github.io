---
import { statusItems } from '../data/profile';
---

<section
  aria-label="At a glance"
  class="border-b border-line bg-panel/40"
>
  <dl class="mx-auto grid max-w-6xl grid-cols-2 divide-line sm:grid-cols-4 sm:divide-x">
    {
      statusItems.map((item) => (
        <div class="border-b border-line px-5 py-4 sm:border-b-0">
          <dt class="mono-label mb-1">{item.label}</dt>
          <dd class="font-mono text-sm text-fg">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
